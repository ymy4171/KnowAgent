POSTGRES_DB=knowagent
POSTGRES_USER=knowagent
POSTGRES_PASSWORD=knowagent_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=knowagent
MINIO_ROOT_PASSWORD=knowagent_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

API_PORT=8080
MANAGEMENT_PORT=8081

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

MINERU_BASE_URL=http://host.docker.internal:30001
PADDLEX_BASE_URL=http://host.docker.internal:8088

# ── Developer-Admin Bootstrap (see README.md) ─────────────────
# Set BOOTSTRAP_ENABLED=true to create the initial tenant, ADMIN
# role and admin user at startup. The flow is idempotent and runs
# inside a single transaction. Never commit a real password here.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Access Token (JWT) ─────────────────────────────────────────
# The API signs and validates Access Tokens with the HS256 key in
# JWT_SECRET (base64-encoded, decoding to at least 32 bytes).
# JWT_ISSUER and JWT_AUDIENCE must match the tokens the API issues;
# the API fails fast at startup until they are set. Never commit a
# real key or token here.
JWT_ISSUER=https://api.knowagent.example
JWT_AUDIENCE=knowagent-api
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
