BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
