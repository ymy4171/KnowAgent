POSTGRES_DB=knowagent
POSTGRES_USER=knowagent
POSTGRES_PASSWORD=knowagent_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

# PostgreSQL Outbox -> Redis Streams -> Worker delivery. The stream key is fixed
# in application.yml; group is shared by all Workers, while each process needs a
# unique consumer name (containers default to their HOSTNAME).
WORKER_STREAM_GROUP=knowledge-file-ingestion
WORKER_CONSUMER_NAME=worker-local
WORKER_STREAM_BATCH_SIZE=20
WORKER_STREAM_POLL_TIMEOUT=1s
WORKER_STREAM_RECLAIM_IDLE=30s
WORKER_TASK_LEASE=5m
WORKER_OUTBOX_LEASE=30s
WORKER_STREAM_POLL_DELAY_MS=250
WORKER_STREAM_RECLAIM_DELAY_MS=5000
WORKER_OUTBOX_PUBLISHER_DELAY_MS=1000
WORKER_OUTBOX_PUBLISHER_ENABLED=true
WORKER_STREAM_CONSUMER_ENABLED=true

MINIO_ROOT_USER=knowagent
MINIO_ROOT_PASSWORD=knowagent_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO client configuration used by the API and Worker. Keep both
# processes on the same bucket and credentials. These are local-only
# placeholders; never commit production credentials here.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=knowagent
MINIO_SECRET_KEY=knowagent_dev
MINIO_BUCKET=knowledge
MINIO_REGION=

# Local document parsing limits (API and Worker use the same values)
PARSE_MAX_BYTES=52428800
PARSE_MAX_PAGES=1000
PARSE_MAX_UNCOMPRESSED_BYTES=536870912
PARSE_MAX_CHARACTERS=10000000
PARSE_TIMEOUT=60s

MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# Milvus client configuration used by the API and Worker. The adapter is only
# enabled when MILVUS_ENDPOINT is set; without it the application boots with a
# fail-fast gateway. MILVUS_DIMENSION must match the embedding model output
# (e.g. 1536 for text-embedding-3-small). Keep both processes on the same
# collection and dimension - an existing collection with a different schema or
# dimension refuses startup and is never dropped.
MILVUS_ENDPOINT=http://localhost:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_DATABASE=
MILVUS_COLLECTION=knowledge_chunks
MILVUS_DIMENSION=1536
MILVUS_INDEX_TYPE=HNSW
MILVUS_INDEX_M=16
MILVUS_INDEX_EF_CONSTRUCTION=64
MILVUS_SEARCH_EF=64
MILVUS_CONNECT_TIMEOUT=5s
MILVUS_RPC_DEADLINE=30s
MILVUS_SEARCH_TIMEOUT=10s
MILVUS_WRITE_TIMEOUT=30s
MILVUS_DELETE_TIMEOUT=30s
MILVUS_INIT_TIMEOUT=120s

API_PORT=8080
MANAGEMENT_PORT=8081

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

MINERU_BASE_URL=http://host.docker.internal:30001
PADDLEX_BASE_URL=http://host.docker.internal:8088

# ── Developer-Admin Bootstrap (see README.md) ─────────────────
# Set BOOTSTRAP_ENABLED=true to create the initial tenant, ADMIN
# role and admin user at startup. The flow is idempotent and runs
# inside a single transaction. Never commit a real password here.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Access Token (JWT) ─────────────────────────────────────────
# The API signs and validates Access Tokens with the HS256 key in
# JWT_SECRET (base64-encoded, decoding to at least 32 bytes).
# JWT_ISSUER and JWT_AUDIENCE must match the tokens the API issues;
# the API fails fast at startup until they are set. Never commit a
# real key or token here.
JWT_ISSUER=https://api.knowagent.example
JWT_AUDIENCE=knowagent-api
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m

# Model-provider AES-256-GCM master key. Supply a base64 value that
# decodes to exactly 32 bytes. API and Worker must use the same key.
# Never commit a real key here.
MODEL_PROVIDER_SECRET_KEY=
